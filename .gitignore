# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# e2e (playwright harness)
e2e/.auth/
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync tool (abandoned)
/.design-sync/
/.ds-sync/
/ds-bundle/
/ds-entry.ts
/.ds-entry.tsx
.claude/task-context/
.claude/.eslintcache
.claude/.ship-authorized
.claude/.destructive-git-authorized

# Throwaway App Store submission checklists (local only)
APPSTORE_SUBMISSION_STEPS.md
APPSTORE_SUBMISSION_STEPS.html

# load-test harness artifacts (tokens are credentials, logs are bulky)
scripts/loadtest/.tokens.json
scripts/loadtest/logs/

# package-lock.json is LOCAL-ONLY. pnpm is authoritative: Vercel's build log reads
# "Detected pnpm-lock.yaml … Using pnpm@10.x" and never looks at package-lock.json,
# and verify.sh validates only pnpm-lock.yaml. Tracking both meant a second lockfile
# that silently drifted (it was stale by several commits when this was found).
# session.sh still runs `npm install --legacy-peer-deps` locally, which regenerates
# this file — that's fine, it just must never be committed again.
package-lock.json
